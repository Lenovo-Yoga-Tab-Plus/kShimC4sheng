# Lenovo Yoga Tab Plus (lapis / SM8650).
# The SHENG_* names are the ones the packer scripts already read. This file
# only changes the device constants; the menu and the boot_a flash target stay.
# boot_a and boot_b are 96 MiB each (0x6000000).
SHENG_BOOT_PARTITION_SIZE=100663296
SHENG_PAGE_SIZE=4096
SHENG_DEFAULT_OS=android
SHENG_TIMEOUT_MS=8000
SHENG_BOOTARGS="root=LABEL=eos-lapis rw rootwait console=tty0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused ignore_loglevel"
# Extraction prefixes used by scripts/prepare.sh.
SHENG_STOCK_PREFIX=stock
SHENG_LINUX_PREFIX=linux
