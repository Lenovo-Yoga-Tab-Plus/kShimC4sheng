# kShimC runtime profile for Lenovo Yoga Tab Plus (lapis, SM8650).
# Same menu as config/sheng_defconfig. Touch stays off.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
# Landscape panel. 270 would make the logical canvas portrait.
CONFIG_KSHIM_UI_ROTATION_CCW=0
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# 20 logical 2944-pixel rows (2944 * 4 * 20); fits the 4 MiB runtime slot.
CONFIG_KSHIM_LVGL_BUFFER_BYTES=235520
# CONFIG_KSHIM_TOUCH is not set
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
CONFIG_KSHIM_MENU_SESSION_SETTINGS=y
# CONFIG_KSHIM_MENU_CHINESE is not set
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
CONFIG_KSHIM_MENU_BASE_ANDROID=y
CONFIG_KSHIM_MENU_SINGLE_LINUX=y
CONFIG_KSHIM_UI_ATLAS=y
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
# CONFIG_KSHIM_BOOT_TIMING is not set

# Fall back to the DT splash reservation when the SDE decoder rejects the
# SM8650 tree. The panel is 2944x1840 XRGB8888, stride 11776.
CONFIG_KSHIM_SPLASH_FALLBACK=y
CONFIG_KSHIM_SPLASH_FALLBACK_WIDTH=2944
CONFIG_KSHIM_SPLASH_FALLBACK_HEIGHT=1840
CONFIG_KSHIM_SPLASH_FALLBACK_STRIDE=11776

CONFIG_KSHIM_DEVICE_BANNER="Lenovo Yoga Tab Plus · lapis · v"
CONFIG_KSHIM_DEVICE_FOOTER="lapis · SM8650"
CONFIG_KSHIM_DEVICE_PAGE_NAME="Lenovo Yoga Tab Plus"
CONFIG_KSHIM_DEVICE_PAGE_DESC="lapis (SM8650)"

CONFIG_KSHIM_BOOT_LAST=y
CONFIG_KSHIM_CHARGER_MODE=y
